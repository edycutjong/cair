# Copy to .env or export these. The app reads the process environment; for local runs it can also load KEY=VALUE files
# named in CAIR_ENV_FILES (colon-separated). Nothing in this repository stores a real value.

# ── neatlogs (tracing, read-back, EVALUATOR write-back) ───────
# Get from: https://app.neatlogs.com (your project's key; see https://docs.neatlogs.com/sdk/python)
NEATLOGS_API_KEY=your-neatlogs-project-key
# Get from: https://app.neatlogs.com (the write key, starts with nlw_; see https://docs.neatlogs.com/sdk/http-injection)
# Used server-side only, for the HTTP /v1/trace write-back.
NEATLOGS_WRITE_KEY=nlw_your-write-key
# Display name of your neatlogs project (the HTTP trace endpoint matches on it)
NEATLOGS_PROJECT=your-project-name
# Optional: only if your workspace uses a different ingest host
# NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# ── Qwen Cloud (the explanation model; OpenAI-compatible) ─────
# Get from: https://bailian.console.alibabacloud.com (Model Studio API key); the base URL below is the international one
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# ── Server ────────────────────────────────────────────────────
# Secret for signing the session cookies; generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CAIR_COOKIE_SECRET=
# Set to 0 only when serving over plain http on localhost
# CAIR_SECURE_COOKIES=0
# SQLite file for plans and receipts (default: var/cair.db)
# CAIR_DB=var/cair.db
# Optional: a secret link token that tags your own test plans as origin=builder (open /?b=<token> once)
# CAIR_BUILDER_TOKEN=
