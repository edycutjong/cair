{
  "ci": {
    "collect": {
      "startServerCommand": "CAIR_SECURE_COOKIES=0 python -m uvicorn cair.app:app --port 8000",
      "startServerReadyPattern": "Application startup complete",
      "url": [
        "http://localhost:8000/",
        "http://localhost:8000/judge",
        "http://localhost:8000/rules"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
